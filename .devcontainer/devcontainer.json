{
  "name": "coreboot-dev",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "..",
    "options": [
      "--network=host"
    ],
    "args": {
      "HOST_UID": "1000"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools"
      ]
    }
  },
  "runArgs": [
    "--network=host"
  ],
  "remoteUser": "coreboot"
}